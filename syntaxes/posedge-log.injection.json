{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "posedge.injection.log",
  "comment": "GENERATED by build/grammars.mts from design/*.mts. Do not edit by hand.",
  "scopeName": "posedge.injection.log",
  "injectionSelector": "L:text.log -meta.posedge",
  "patterns": [
    {
      "include": "#log"
    }
  ],
  "repository": {
    "log": {
      "patterns": [
        {
          "match": "^(?:#\\s*)?(UVM_INFO)(\\s*:\\s*)(0)\\s*$",
          "captures": {
            "1": {
              "name": "constant.other.severity.info.posedge.log"
            },
            "3": {
              "name": "markup.inserted.pass.posedge.log"
            }
          }
        },
        {
          "match": "^(?:#\\s*)?(UVM_INFO)(\\s*:\\s*)([1-9]\\d*)\\s*$",
          "captures": {
            "1": {
              "name": "constant.other.severity.info.posedge.log"
            },
            "3": {
              "name": "constant.other.severity.info.posedge.log"
            }
          }
        },
        {
          "begin": "^(?:#\\s*)?(UVM_INFO)(?![\\w$])",
          "beginCaptures": {
            "1": {
              "name": "constant.other.severity.info.posedge.log"
            }
          },
          "end": "$",
          "name": "meta.posedge.uvm-info.log",
          "patterns": [
            {
              "match": "(@)\\s*(\\d[\\d.,_]*\\s*(?:fs|ps|ns|us|ms|s)?)",
              "captures": {
                "1": {
                  "name": "keyword.operator.timing.posedge.log"
                },
                "2": {
                  "name": "constant.numeric.time.posedge.log"
                }
              }
            },
            {
              "match": "\\[([^\\]\\s]+)\\]",
              "captures": {
                "0": {
                  "name": "constant.other.severity.info.posedge.log"
                }
              }
            },
            {
              "match": "[\\w./\\\\-]+\\.(?:sv|svh|v|vh|sva|svi|vhd|vhdl|c|cpp|h)\\(\\d+\\)",
              "name": "string.other.path.posedge.log"
            },
            {
              "match": "\\b[A-Za-z_][\\w$]*(?:\\.[A-Za-z_][\\w$\\[\\]]*)+(?=\\s*\\[|\\s*:)",
              "name": "entity.name.namespace.hierarchy.posedge.log"
            },
            {
              "include": "text.log"
            }
          ]
        },
        {
          "match": "^(?:#\\s*)?(UVM_WARNING)(\\s*:\\s*)(0)\\s*$",
          "captures": {
            "1": {
              "name": "constant.other.severity.warning.posedge.log"
            },
            "3": {
              "name": "markup.inserted.pass.posedge.log"
            }
          }
        },
        {
          "match": "^(?:#\\s*)?(UVM_WARNING)(\\s*:\\s*)([1-9]\\d*)\\s*$",
          "captures": {
            "1": {
              "name": "constant.other.severity.warning.posedge.log"
            },
            "3": {
              "name": "constant.other.severity.warning.posedge.log"
            }
          }
        },
        {
          "begin": "^(?:#\\s*)?(UVM_WARNING)(?![\\w$])",
          "beginCaptures": {
            "1": {
              "name": "constant.other.severity.warning.posedge.log"
            }
          },
          "end": "$",
          "name": "meta.posedge.uvm-warning.log",
          "patterns": [
            {
              "match": "(@)\\s*(\\d[\\d.,_]*\\s*(?:fs|ps|ns|us|ms|s)?)",
              "captures": {
                "1": {
                  "name": "keyword.operator.timing.posedge.log"
                },
                "2": {
                  "name": "constant.numeric.time.posedge.log"
                }
              }
            },
            {
              "match": "\\[([^\\]\\s]+)\\]",
              "captures": {
                "0": {
                  "name": "constant.other.severity.warning.posedge.log"
                }
              }
            },
            {
              "match": "[\\w./\\\\-]+\\.(?:sv|svh|v|vh|sva|svi|vhd|vhdl|c|cpp|h)\\(\\d+\\)",
              "name": "string.other.path.posedge.log"
            },
            {
              "match": "\\b[A-Za-z_][\\w$]*(?:\\.[A-Za-z_][\\w$\\[\\]]*)+(?=\\s*\\[|\\s*:)",
              "name": "entity.name.namespace.hierarchy.posedge.log"
            },
            {
              "include": "text.log"
            }
          ]
        },
        {
          "match": "^(?:#\\s*)?(UVM_ERROR)(\\s*:\\s*)(0)\\s*$",
          "captures": {
            "1": {
              "name": "constant.other.severity.error.posedge.log"
            },
            "3": {
              "name": "markup.inserted.pass.posedge.log"
            }
          }
        },
        {
          "match": "^(?:#\\s*)?(UVM_ERROR)(\\s*:\\s*)([1-9]\\d*)\\s*$",
          "captures": {
            "1": {
              "name": "constant.other.severity.error.posedge.log"
            },
            "3": {
              "name": "markup.deleted.fail.posedge.log"
            }
          }
        },
        {
          "begin": "^(?:#\\s*)?(UVM_ERROR)(?![\\w$])",
          "beginCaptures": {
            "1": {
              "name": "constant.other.severity.error.posedge.log"
            }
          },
          "end": "$",
          "name": "meta.posedge.uvm-error.log",
          "patterns": [
            {
              "match": "(@)\\s*(\\d[\\d.,_]*\\s*(?:fs|ps|ns|us|ms|s)?)",
              "captures": {
                "1": {
                  "name": "keyword.operator.timing.posedge.log"
                },
                "2": {
                  "name": "constant.numeric.time.posedge.log"
                }
              }
            },
            {
              "match": "\\[([^\\]\\s]+)\\]",
              "captures": {
                "0": {
                  "name": "constant.other.severity.error.posedge.log"
                }
              }
            },
            {
              "match": "[\\w./\\\\-]+\\.(?:sv|svh|v|vh|sva|svi|vhd|vhdl|c|cpp|h)\\(\\d+\\)",
              "name": "string.other.path.posedge.log"
            },
            {
              "match": "\\b[A-Za-z_][\\w$]*(?:\\.[A-Za-z_][\\w$\\[\\]]*)+(?=\\s*\\[|\\s*:)",
              "name": "entity.name.namespace.hierarchy.posedge.log"
            },
            {
              "include": "text.log"
            }
          ]
        },
        {
          "match": "^(?:#\\s*)?(UVM_FATAL)(\\s*:\\s*)(0)\\s*$",
          "captures": {
            "1": {
              "name": "constant.other.severity.fatal.posedge.log"
            },
            "3": {
              "name": "markup.inserted.pass.posedge.log"
            }
          }
        },
        {
          "match": "^(?:#\\s*)?(UVM_FATAL)(\\s*:\\s*)([1-9]\\d*)\\s*$",
          "captures": {
            "1": {
              "name": "constant.other.severity.fatal.posedge.log"
            },
            "3": {
              "name": "markup.deleted.fail.posedge.log"
            }
          }
        },
        {
          "begin": "^(?:#\\s*)?(UVM_FATAL)(?![\\w$])",
          "beginCaptures": {
            "1": {
              "name": "constant.other.severity.fatal.posedge.log"
            }
          },
          "end": "$",
          "name": "meta.posedge.uvm-fatal.log",
          "patterns": [
            {
              "match": "(@)\\s*(\\d[\\d.,_]*\\s*(?:fs|ps|ns|us|ms|s)?)",
              "captures": {
                "1": {
                  "name": "keyword.operator.timing.posedge.log"
                },
                "2": {
                  "name": "constant.numeric.time.posedge.log"
                }
              }
            },
            {
              "match": "\\[([^\\]\\s]+)\\]",
              "captures": {
                "0": {
                  "name": "constant.other.severity.fatal.posedge.log"
                }
              }
            },
            {
              "match": "[\\w./\\\\-]+\\.(?:sv|svh|v|vh|sva|svi|vhd|vhdl|c|cpp|h)\\(\\d+\\)",
              "name": "string.other.path.posedge.log"
            },
            {
              "match": "\\b[A-Za-z_][\\w$]*(?:\\.[A-Za-z_][\\w$\\[\\]]*)+(?=\\s*\\[|\\s*:)",
              "name": "entity.name.namespace.hierarchy.posedge.log"
            },
            {
              "include": "text.log"
            }
          ]
        },
        {
          "match": "^(?:#\\s*)?-{2,}\\s*UVM Report (?:catcher )?Summary\\s*-{2,}.*$",
          "name": "markup.heading.summary.posedge.log"
        },
        {
          "match": "^(?:#\\s*)?\\*\\*\\s*Report counts by (?:severity|id).*$",
          "name": "markup.heading.summary.posedge.log"
        },
        {
          "match": "^(?:#\\s*)?(\\*\\*\\s*(?:Fatal)(?:\\s*\\(suppressible\\))?:)",
          "captures": {
            "1": {
              "name": "constant.other.severity.fatal.posedge.log"
            }
          }
        },
        {
          "match": "^(?:#\\s*)?(\\*\\*\\s*(?:Error)(?:\\s*\\(suppressible\\))?:)",
          "captures": {
            "1": {
              "name": "constant.other.severity.error.posedge.log"
            }
          }
        },
        {
          "match": "^(?:#\\s*)?(\\*\\*\\s*Warning(?:\\s*\\(suppressible\\))?:)",
          "captures": {
            "1": {
              "name": "constant.other.severity.warning.posedge.log"
            }
          }
        },
        {
          "match": "^(?:#\\s*)?(\\*\\*\\s*(?:Note|Info):)",
          "captures": {
            "1": {
              "name": "constant.other.severity.info.posedge.log"
            }
          }
        },
        {
          "match": "^((?:Error|Fatal)-\\[[^\\]]+\\])",
          "captures": {
            "1": {
              "name": "constant.other.severity.error.posedge.log"
            }
          }
        },
        {
          "match": "^((?:Warning|Lint)-\\[[^\\]]+\\])",
          "captures": {
            "1": {
              "name": "constant.other.severity.warning.posedge.log"
            }
          }
        },
        {
          "match": "^((?:Note|Information)-\\[[^\\]]+\\])",
          "captures": {
            "1": {
              "name": "constant.other.severity.info.posedge.log"
            }
          }
        },
        {
          "match": "^(?:\\w+:\\s*)?(\\*F,\\w+)",
          "captures": {
            "1": {
              "name": "constant.other.severity.fatal.posedge.log"
            }
          }
        },
        {
          "match": "^(?:\\w+:\\s*)?(\\*E,\\w+)",
          "captures": {
            "1": {
              "name": "constant.other.severity.error.posedge.log"
            }
          }
        },
        {
          "match": "^(?:\\w+:\\s*)?(\\*W,\\w+)",
          "captures": {
            "1": {
              "name": "constant.other.severity.warning.posedge.log"
            }
          }
        },
        {
          "match": "^(?:\\w+:\\s*)?(\\*N,\\w+)",
          "captures": {
            "1": {
              "name": "constant.other.severity.info.posedge.log"
            }
          }
        },
        {
          "match": "^(%Error(?:-[\\w-]+)?:)",
          "captures": {
            "1": {
              "name": "constant.other.severity.error.posedge.log"
            }
          }
        },
        {
          "match": "^(%Warning(?:-[\\w-]+)?:)",
          "captures": {
            "1": {
              "name": "constant.other.severity.warning.posedge.log"
            }
          }
        },
        {
          "match": "^(ERROR:)",
          "captures": {
            "1": {
              "name": "constant.other.severity.error.posedge.log"
            }
          }
        },
        {
          "match": "^(CRITICAL WARNING:)",
          "captures": {
            "1": {
              "name": "constant.other.severity.error.posedge.log"
            }
          }
        },
        {
          "match": "^(WARNING:)",
          "captures": {
            "1": {
              "name": "constant.other.severity.warning.posedge.log"
            }
          }
        },
        {
          "match": "\\b(?:Assertion\\s+\\S+\\s+failed|Offending\\s+'[^']*'|failed at\\s+\\d+\\s*\\w*)",
          "name": "markup.deleted.fail.posedge.log"
        },
        {
          "match": "\\b(?:TEST(?:CASE)?\\s+PASS(?:ED)?|SIMULATION\\s+PASS(?:ED)?|ALL\\s+TESTS\\s+PASSED|PASSED)\\b",
          "name": "markup.inserted.pass.posedge.log"
        },
        {
          "match": "\\b(?:TEST(?:CASE)?\\s+FAIL(?:ED)?|SIMULATION\\s+FAIL(?:ED)?|FAILED)\\b",
          "name": "markup.deleted.fail.posedge.log"
        },
        {
          "match": "\\$(?:finish|stop)\\b",
          "name": "support.function.library.posedge.log"
        },
        {
          "match": "(?:\\b(?:at\\s+)?time\\s*[:=]?\\s*|@\\s*)(\\d[\\d.,_]*\\s*(?:fs|ps|ns|us|ms|s)?)\\b",
          "captures": {
            "1": {
              "name": "constant.numeric.time.posedge.log"
            }
          }
        }
      ]
    }
  }
}
