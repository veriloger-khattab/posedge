{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "posedge.injection.verilog-filelist",
  "comment": "GENERATED by build/grammars.mts from design/*.mts. Do not edit by hand.",
  "scopeName": "posedge.injection.verilog-filelist",
  "injectionSelector": "L:source.verilog-filelist -meta.posedge",
  "patterns": [
    {
      "include": "#filelist"
    }
  ],
  "repository": {
    "filelist": {
      "patterns": [
        {
          "match": "(?:^|(?<=\\s))//.*$",
          "name": "comment.line.double-slash.posedge.verilog-filelist"
        },
        {
          "match": "(?:^|(?<=\\s))#.*$",
          "name": "comment.line.double-slash.posedge.verilog-filelist"
        },
        {
          "match": "(\\+define)((?:\\+[A-Za-z_][\\w$]*(?:=[^\\s+]*)?)+)\\+?",
          "captures": {
            "1": {
              "name": "keyword.preprocessor.posedge.verilog-filelist"
            },
            "2": {
              "name": "meta.posedge.capture.verilog-filelist",
              "patterns": [
                {
                  "match": "\\+",
                  "name": "keyword.preprocessor.posedge.verilog-filelist"
                },
                {
                  "match": "[A-Za-z_][\\w$]*",
                  "name": "keyword.preprocessor.definition.posedge.verilog-filelist"
                },
                {
                  "match": "(=)(\"[^\"]*\"|[^\\s+]*)",
                  "captures": {
                    "1": {
                      "name": "keyword.operator.posedge.verilog-filelist"
                    },
                    "2": {
                      "name": "constant.numeric.posedge.verilog-filelist"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "match": "(?<!\\S)\\+[A-Za-z_][\\w-]*\\+?",
          "name": "keyword.preprocessor.posedge.verilog-filelist"
        },
        {
          "match": "(?<!\\S)-{1,2}[A-Za-z][\\w-]*(?:=\\S*)?",
          "name": "keyword.preprocessor.posedge.verilog-filelist"
        },
        {
          "match": "\\$\\{\\w+\\}|\\$\\(\\w+\\)|\\$\\w+|%\\w+%",
          "name": "variable.other.constant.posedge.verilog-filelist"
        },
        {
          "match": "\"[^\"]*\"",
          "name": "string.quoted.double.posedge.verilog-filelist"
        },
        {
          "match": "\\S+?(?=\\$|\\s|$)|\\S",
          "name": "string.unquoted.path.posedge.verilog-filelist"
        },
        {
          "match": "\\s+"
        }
      ]
    }
  }
}
