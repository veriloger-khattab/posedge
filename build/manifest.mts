// Syncs the generated parts of the manifest and runtime from build/font/glyph-map.json:
//   * package.json  contributes.icons   one icon per clock glyph (font + PUA character)
//   * package.json  contributes.colors  the clock's defaults for non-Posedge themes follow the accents
//   * src/clock/glyphs.generated.mts    character -> icon id, used by the clock

import { readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { ACCENT, DAYLIGHT_ACCENT } from '../design/palette.mts';

const ROOT = join(import.meta.dirname, '..');

interface GlyphMap {
  font: string;
  glyphs: Array<{ char: string; id: string; codepoint: number }>;
}

export function syncManifest(): void {
  const map = JSON.parse(readFileSync(join(ROOT, 'build', 'font', 'glyph-map.json'), 'utf8')) as GlyphMap;
  const pkgPath = join(ROOT, 'package.json');
  const pkg = JSON.parse(readFileSync(pkgPath, 'utf8'));
  const icons: Record<string, unknown> = {};
  for (const g of map.glyphs) {
    icons[g.id] = {
      description: `Posedge clock glyph "${g.char}" (JetBrains Mono)`,
      default: { fontPath: map.font, fontCharacter: `\\${g.codepoint.toString(16).toUpperCase()}` },
    };
  }
  pkg.contributes.icons = icons;
  const clock = pkg.contributes.colors.find((c: { id: string }) => c.id === 'posedge.clockForeground');
  clock.defaults.dark = ACCENT;
  clock.defaults.light = DAYLIGHT_ACCENT;
  writeFileSync(pkgPath, `${JSON.stringify(pkg, null, 2)}\n`);

  const entries = map.glyphs.map((g) => `  ${JSON.stringify(g.char)}: ${JSON.stringify(g.id)},`).join('\n');
  writeFileSync(
    join(ROOT, 'src', 'clock', 'glyphs.generated.mts'),
    `// GENERATED by build/manifest.mts from build/font/glyph-map.json. Do not edit by hand.\n` +
      `// Characters the clock can draw with the bundled JetBrains Mono glyph font.\n\n` +
      `export const GLYPHS: Readonly<Record<string, string>> = {\n${entries}\n};\n`,
  );
  console.log(`synced ${map.glyphs.length} clock glyph icons into package.json and src/clock/glyphs.generated.mts`);
}

if (import.meta.main) syncManifest();
