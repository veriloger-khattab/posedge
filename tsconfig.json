{
  // Type-checks the runtime extension code in src/ (bundled by esbuild, so "bundler" resolution).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vscode"]
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "design/uvm.mts"]
}
