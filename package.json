{
  "name": "posedge",
  "displayName": "Posedge — SystemVerilog & UVM Theme",
  "description": "SystemVerilog & UVM color themes, lexer, file icons and clock where every color means something. Designed by Ahmed Khattab.",
  "version": "0.8.0",
  "publisher": "ahmedkhattab",
  "license": "MIT",
  "homepage": "https://github.com/veriloger-khattab/posedge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/veriloger-khattab/posedge.git"
  },
  "bugs": {
    "url": "https://github.com/veriloger-khattab/posedge/issues"
  },
  "qna": "https://github.com/veriloger-khattab/posedge/issues",
  "author": {
    "name": "Ahmed Khattab",
    "url": "https://github.com/veriloger-khattab"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "systemverilog",
    "uvm",
    "verilog",
    "verification",
    "sva",
    "coverage",
    "rtl",
    "hdl",
    "asic",
    "fpga",
    "dark theme",
    "light theme",
    "icon theme",
    "file icons",
    "clock",
    "jetbrains mono"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#141414",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "themes": [
      {
        "label": "Posedge Graphite",
        "uiTheme": "vs-dark",
        "path": "./themes/posedge-graphite-color-theme.json"
      },
      {
        "label": "Posedge Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/posedge-midnight-color-theme.json"
      },
      {
        "label": "Posedge Daylight",
        "uiTheme": "vs",
        "path": "./themes/posedge-daylight-color-theme.json"
      },
      {
        "label": "Posedge High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/posedge-high-contrast-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "posedge-icons",
        "label": "Posedge Icons",
        "path": "./icons/posedge-icon-theme.json",
        "_watch": true
      },
      {
        "id": "posedge-icons-still",
        "label": "Posedge Icons (Still)",
        "path": "./icons/posedge-still-icon-theme.json",
        "_watch": true
      }
    ],
    "grammars": [
      {
        "scopeName": "posedge.injection.systemverilog",
        "path": "./syntaxes/posedge-systemverilog.injection.json",
        "injectTo": [
          "source.systemverilog"
        ]
      },
      {
        "scopeName": "posedge.injection.verilog",
        "path": "./syntaxes/posedge-verilog.injection.json",
        "injectTo": [
          "source.verilog"
        ]
      },
      {
        "scopeName": "posedge.injection.log",
        "path": "./syntaxes/posedge-log.injection.json",
        "injectTo": [
          "text.log"
        ]
      },
      {
        "scopeName": "posedge.injection.verilog-filelist",
        "path": "./syntaxes/posedge-filelist.injection.json",
        "injectTo": [
          "source.verilog-filelist"
        ]
      }
    ],
    "languages": [
      {
        "id": "systemverilog",
        "extensions": [
          ".sva",
          ".svi"
        ]
      },
      {
        "id": "tcl",
        "extensions": [
          ".do"
        ]
      },
      {
        "id": "log",
        "filenames": [
          "transcript"
        ]
      },
      {
        "id": "verilog-filelist",
        "extensions": [
          ".vc",
          ".flist"
        ]
      }
    ],
    "configurationDefaults": {
      "[systemverilog]": {
        "editor.language.colorizedBracketPairs": [
          [
            "(",
            ")"
          ],
          [
            "[",
            "]"
          ],
          [
            "{",
            "}"
          ]
        ]
      },
      "[verilog]": {
        "editor.language.colorizedBracketPairs": [
          [
            "(",
            ")"
          ],
          [
            "[",
            "]"
          ],
          [
            "{",
            "}"
          ]
        ]
      }
    },
    "configuration": {
      "title": "Posedge",
      "properties": {
        "posedge.clock.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the Posedge clock (time and date) in the status bar.",
          "order": 0
        },
        "posedge.clock.timeFormat": {
          "type": "string",
          "default": "{HH}:{mm}",
          "markdownDescription": "Format of the time item. Tokens: `{HH}` `{H}` `{hh}` `{h}` `{mm}` `{ss}` `{A}` `{a}`. Including `{ss}` makes the clock tick every second. Leave empty to hide the time item.",
          "order": 1
        },
        "posedge.clock.dateFormat": {
          "type": "string",
          "default": "{ddd} {DD} {MMM} · WW{WW}",
          "markdownDescription": "Format of the date item. Tokens: `{ddd}` `{dddd}` `{DD}` `{D}` `{MMM}` `{MMMM}` `{MM}` `{M}` `{YYYY}` `{YY}` `{WW}` (work week) `{W}` `{WD}` (work-week day) `{Q}` (quarter) `{DOY}` (day of year). Leave empty to hide the date item.",
          "order": 2
        },
        "posedge.clock.workWeekStyle": {
          "type": "string",
          "enum": [
            "iso",
            "sunday"
          ],
          "enumDescriptions": [
            "ISO 8601: weeks start on Monday and week 1 contains the first Thursday. Work-week day {WD} is 1 (Mon) to 7 (Sun).",
            "Sunday-start (Intel style): weeks start on Sunday and WW01 is the week that contains January 1. Work-week day {WD} is 0 (Sun) to 6 (Sat)."
          ],
          "default": "iso",
          "markdownDescription": "How the `{WW}` work-week number is computed.",
          "order": 3
        },
        "posedge.clock.timeZones": {
          "type": "array",
          "default": [],
          "markdownDescription": "Extra clocks shown in the tooltip, for teammates in other sites. Each entry is `{ \"label\": \"Austin\", \"timeZone\": \"America/Chicago\" }` using IANA time zone names.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "timeZone"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "timeZone": {
                "type": "string"
              }
            }
          },
          "order": 4
        },
        "posedge.clock.clickAction": {
          "type": "string",
          "enum": [
            "copyTimestamp",
            "toggleSeconds",
            "none"
          ],
          "enumDescriptions": [
            "Copy an ISO-8601 timestamp (2026-10-18 14:37:05) to the clipboard.",
            "Show or hide seconds.",
            "Do nothing."
          ],
          "default": "copyTimestamp",
          "markdownDescription": "What happens when you click the clock.",
          "order": 5
        },
        "posedge.clock.alignment": {
          "type": "string",
          "enum": [
            "right",
            "left"
          ],
          "default": "right",
          "markdownDescription": "Which side of the status bar the clock sits on.",
          "order": 6
        },
        "posedge.clock.priority": {
          "type": "number",
          "default": -1000,
          "markdownDescription": "Status bar priority. Higher values place the clock further left.",
          "order": 7
        },
        "posedge.clock.useGlyphFont": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Render the clock with the bundled JetBrains Mono glyphs. Turn off to use the regular status bar font.",
          "order": 8
        },
        "posedge.explorer.uvmRoleBadges": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a two-letter UVM role badge (DR driver, MO monitor, SB scoreboard, …) next to SystemVerilog files in the Explorer, based on the class inside or the file name suffix. Badges never change label colors.",
          "order": 20
        },
        "posedge.explorer.classIcons": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Give `.sv`, `.svh` and `.svi` files the icon of the class they declare: an eye for a monitor, a steering wheel for a driver, a Wi-Fi signal for coverage, … Requires *Posedge Icons*. Reads those files as plain text and records the result in Posedge's own icon theme files, inside its extension folder. Turn off to go back to fixed icons.",
          "order": 21
        }
      }
    },
    "commands": [
      {
        "command": "posedge.clock.copyTimestamp",
        "title": "Copy Timestamp",
        "category": "Posedge"
      },
      {
        "command": "posedge.clock.insertTimestamp",
        "title": "Insert Timestamp",
        "category": "Posedge"
      },
      {
        "command": "posedge.clock.toggle",
        "title": "Toggle Clock",
        "category": "Posedge"
      },
      {
        "command": "posedge.clock.toggleSeconds",
        "title": "Toggle Clock Seconds",
        "category": "Posedge"
      },
      {
        "command": "posedge.explorer.toggleRoleBadges",
        "title": "Toggle UVM Role Badges",
        "category": "Posedge"
      },
      {
        "command": "posedge.explorer.refreshClassIcons",
        "title": "Refresh Class Icons",
        "category": "Posedge"
      }
    ],
    "colors": [
      {
        "id": "posedge.clockForeground",
        "description": "Color of the time shown by the Posedge clock in the status bar.",
        "defaults": {
          "dark": "#FD9720",
          "light": "#9F5400",
          "highContrast": "#FFB45C",
          "highContrastLight": "#7A4100"
        }
      },
      {
        "id": "posedge.dateForeground",
        "description": "Color of the date shown by the Posedge clock in the status bar.",
        "defaults": {
          "dark": "statusBar.foreground",
          "light": "statusBar.foreground",
          "highContrast": "statusBar.foreground",
          "highContrastLight": "statusBar.foreground"
        }
      }
    ],
