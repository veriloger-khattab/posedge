    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with Posedge",
        "description": "Colors that mean something in SystemVerilog and UVM, lit folders and a JetBrains Mono clock. Designed by Ahmed Khattab.",
        "steps": [
          {
            "id": "theme",
            "title": "Pick a Posedge color theme",
            "description": "Graphite is the default, Midnight is darker, Daylight is the light one, High Contrast meets WCAG AAA.\n[Choose a color theme](command:workbench.action.selectTheme)",
            "media": {
              "markdown": "media/walkthrough/theme.md"
            },
            "completionEvents": [
              "onSettingChanged:workbench.colorTheme"
            ]
          },
          {
            "id": "icons",
            "title": "Turn on Posedge Icons",
            "description": "Closed folders stay dark; open folders light up amber and run a tiny clock. A Still variant has no motion.\n[Choose a file icon theme](command:workbench.action.selectIconTheme)",
            "media": {
              "markdown": "media/walkthrough/icons.md"
            },
            "completionEvents": [
              "onSettingChanged:workbench.iconTheme"
            ]
          },
          {
            "id": "settings",
            "title": "Recommended editor settings",
            "description": "JetBrains Mono NL, sticky scroll and always-on tree indent guides.\n[Open user settings (JSON)](command:workbench.action.openSettingsJson)",
            "media": {
              "markdown": "media/walkthrough/settings.md"
            }
          },
          {
            "id": "clock",
            "title": "Configure the clock",
            "description": "Time, date and work week in JetBrains Mono, with extra time zones in the tooltip.\n[Open clock settings](command:workbench.action.openSettings?%5B%22posedge.clock%22%5D)",
            "media": {
              "markdown": "media/walkthrough/clock.md"
            }
          },
          {
            "id": "legend",
            "title": "Learn the color language",
            "description": "One meaning per color: keywords, macros, types, functions, time and concurrency, verification, and the reserved severity colors.",
            "media": {
              "image": {
                "dark": "media/walkthrough/legend.svg",
                "light": "media/walkthrough/legend-daylight.svg",
                "hc": "media/walkthrough/legend.svg",
                "hcLight": "media/walkthrough/legend-daylight.svg"
              },
              "altText": "The Posedge color legend"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node build/themes.mts && node build/grammars.mts && node build/icons.mts && node build/legend.mts && node build/reference.mts && node build/manifest.mts && node build/bundle.mts",
    "build:themes": "node build/themes.mts",
    "build:grammars": "node build/grammars.mts",
    "build:icons": "node build/icons.mts",
    "build:manifest": "node build/manifest.mts",
    "build:font": "python build/font/build_clock_font.py",
    "build:ext": "node build/bundle.mts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "validate": "node build/validate.mts",
    "test": "node --test \"test/*.test.mts\"",
    "verify": "node build/verify.mts",
    "preview": "node build/preview.mts",
    "package": "npm run build && npm run verify && node -e \"require('fs').mkdirSync('dist-vsix',{recursive:true})\" && vsce package --no-dependencies --out dist-vsix/",
    "package:lite": "node build/package-lite.mts",
    "install:local": "node tools/install-local.mts",
    "build:legend": "node build/legend.mts",
    "gallery": "node build/gallery.mts && node build/clock-mock.mts",
    "screenshots": "node build/preview.mts && node build/gallery.mts && node build/clock-mock.mts && node build/screenshots.mts",
    "build:reference": "node build/reference.mts",
    "test:local": "node --test \"test/*.test.mts\" \"tools/**/*.test.mts\"",
    "publish:openvsx": "node build/publish-openvsx.mts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
