// Workbench (UI) colors per variant. Bordered neutral graphite chrome with one warm accent,
// and every semantic color (errors, warnings, git, terminal ANSI, symbols) taken from the same
// roles the code uses, so a color means the same thing everywhere.

import { mix, withAlpha as a } from '../build/lib/color.mts';
import type { Variant } from './palette.mts';

export function workbenchColors(v: Variant): Record<string, string> {
  const { surface: s, ink, syntax: h, accent, accentFill: fill } = v;
  const hc = v.type === 'hc';
  const light = v.type === 'light';
  const accentInk = '#141414'; // text on accent-filled surfaces
  const roleInk = light ? '#FFFFFF' : accentInk; // text on a solid role color (deep on paper, bright on dark)
  // One step toward more emphasis: brighter on dark surfaces, deeper on paper.
  const stronger = (color: string, t: number): string => mix(color, light ? '#000000' : '#FFFFFF', t);
  // On paper a mix toward the background would wash these out, so the status items stay solid.
  const errorBg = light ? h.error : mix(h.error, s.editor, hc ? 0.35 : 0.55);
  const warningBg = light ? h.warning : mix(h.warning, s.editor, 0.45);
  // ANSI magenta is the terminal's, not a Posedge role, so tool output keeps its color.
  const magenta = light ? '#B82B96' : '#FF7AC6';

  const colors: Record<string, string> = {
    // ---- base
    focusBorder: a(accent, hc ? 1 : 0.6),
    foreground: ink.fg,
    disabledForeground: ink.faint,
    descriptionForeground: ink.muted,
    errorForeground: h.error,
    'icon.foreground': ink.muted,
    'widget.shadow': hc ? '#00000000' : light ? '#00000029' : '#00000080',
    'selection.background': a(s.selection, 0.9),
    'textLink.foreground': h.time,
    'textLink.activeForeground': stronger(h.time, 0.25),
    'textPreformat.foreground': h.macro,
    'textPreformat.background': a(h.macro, 0.1),
    'textBlockQuote.background': s.widget,
    'textBlockQuote.border': a(accent, 0.5),
    'textCodeBlock.background': s.widget,
    'textSeparator.foreground': s.borderStrong,
    'sash.hoverBorder': a(accent, 0.6),
    'progressBar.background': accent,
    'toolbar.hoverBackground': s.hover,
    'toolbar.activeBackground': s.active,

    // ---- window chrome (bordered style)
    'titleBar.activeBackground': s.chrome,
    'titleBar.activeForeground': ink.fg,
    'titleBar.inactiveBackground': s.chrome,
    'titleBar.inactiveForeground': ink.subtle,
    'titleBar.border': s.border,
    'commandCenter.background': s.widget,
    'commandCenter.foreground': ink.muted,
    'commandCenter.activeBackground': s.hover,
    'commandCenter.border': s.border,
    'commandCenter.activeBorder': a(accent, 0.5),
    'menubar.selectionBackground': s.hover,
    'menu.background': s.widget,
    'menu.foreground': ink.fg,
    'menu.selectionBackground': a(fill, 0.18),
    'menu.selectionForeground': ink.bright,
    'menu.separatorBackground': s.border,
    'menu.border': s.borderStrong,

    'activityBar.background': s.chrome,
    'activityBar.foreground': ink.fg,
    'activityBar.inactiveForeground': ink.subtle,
    'activityBar.activeBorder': accent,
    'activityBar.activeBackground': a(fill, 0.08),
    'activityBar.border': s.border,
    'activityBarBadge.background': fill,
    'activityBarBadge.foreground': accentInk,
    'activityBarTop.foreground': ink.fg,
    'activityBarTop.inactiveForeground': ink.subtle,
    'activityBarTop.activeBorder': accent,

    'sideBar.background': s.sidebar,
    'sideBar.foreground': ink.fg,
    'sideBar.border': s.border,
    'sideBarTitle.foreground': ink.fg,
    'sideBarSectionHeader.background': s.sidebar,
    'sideBarSectionHeader.foreground': ink.fg,
    'sideBarSectionHeader.border': s.border,
    'sideBarStickyScroll.background': s.sidebar,

    // ---- lists and trees: the selected row glows warm; the active indent guide lights the path
    'list.activeSelectionBackground': a(fill, 0.3),
    'list.activeSelectionForeground': ink.bright,
    'list.activeSelectionIconForeground': ink.bright,
    // Focus is usually in the editor, so this is how the file you are working on normally looks.
    'list.inactiveSelectionBackground': a(fill, 0.22),
    'list.inactiveSelectionForeground': ink.bright,
    'list.hoverBackground': a(ink.fg, 0.05),
    'list.hoverForeground': ink.fg,
    'list.focusBackground': a(fill, 0.14),
    'list.focusOutline': a(accent, 0.55),
    'list.focusAndSelectionOutline': a(accent, 0.8),
    'list.inactiveFocusOutline': a(accent, 0.3),
    'list.highlightForeground': accent,
    'list.focusHighlightForeground': stronger(accent, 0.2),
    'list.errorForeground': h.error,
    'list.warningForeground': h.warning,
    'list.invalidItemForeground': h.error,
    'list.deemphasizedForeground': ink.muted,
    'list.dropBackground': a(fill, 0.15),
    'listFilterWidget.background': s.widget,
    'listFilterWidget.outline': a(accent, 0.6),
    'listFilterWidget.noMatchesOutline': h.error,
    'tree.indentGuidesStroke': a(accent, 0.75),
    'tree.inactiveIndentGuidesStroke': s.borderStrong,
    'tree.tableColumnsBorder': s.border,

    // ---- editor groups and tabs
    'editorGroup.border': s.border,
    'editorGroup.dropBackground': a(fill, 0.12),
    'editorGroupHeader.tabsBackground': s.sidebar,
    'editorGroupHeader.tabsBorder': s.border,
    'editorGroupHeader.noTabsBackground': s.editor,
    'editorGroupHeader.border': s.border,
    'tab.activeBackground': s.editor,
    'tab.activeForeground': ink.bright,
    'tab.activeBorderTop': accent,
    'tab.activeBorder': s.editor,
    'tab.inactiveBackground': s.sidebar,
    'tab.inactiveForeground': ink.subtle,
    'tab.border': s.border,
    'tab.hoverBackground': s.hover,
    'tab.hoverForeground': ink.fg,
    'tab.unfocusedActiveBorderTop': a(accent, 0.4),
    'tab.unfocusedActiveForeground': ink.muted,
    'tab.unfocusedInactiveForeground': ink.faint,
    'tab.unfocusedActiveBackground': s.editor,
    'tab.activeModifiedBorder': h.warning,
    'tab.inactiveModifiedBorder': a(h.warning, 0.5),
    'tab.lastPinnedBorder': s.borderStrong,
    'breadcrumb.foreground': ink.subtle,
    'breadcrumb.focusForeground': ink.fg,
    'breadcrumb.activeSelectionForeground': accent,
    'breadcrumb.background': s.editor,
    'breadcrumbPicker.background': s.widget,

    // ---- editor
    'editor.background': s.editor,
    'editor.foreground': ink.fg,
    'editorCursor.foreground': accent,
    'editorCursor.background': s.editor,
    'editor.lineHighlightBackground': s.lineHighlight,
    'editor.lineHighlightBorder': hc ? a(accent, 0.5) : s.lineHighlight,
    'editorLineNumber.foreground': ink.faint,
    'editorLineNumber.activeForeground': accent,
    'editorLineNumber.dimmedForeground': a(ink.faint, 0.6),
    'editor.selectionBackground': s.selection,
    'editor.selectionHighlightBackground': a(s.selection, 0.55),
    'editor.selectionHighlightBorder': hc ? a(accent, 0.8) : a(s.selection, 0),
    'editor.inactiveSelectionBackground': a(s.selection, 0.5),
    'editor.wordHighlightBackground': a(h.time, 0.16),
    'editor.wordHighlightBorder': a(h.time, 0.45),
    'editor.wordHighlightStrongBackground': a(h.keyword, 0.16),
    'editor.wordHighlightStrongBorder': a(h.keyword, 0.45),
    'editor.wordHighlightTextBackground': a(h.time, 0.12),
    'editor.findMatchBackground': a(fill, 0.38),
    'editor.findMatchBorder': accent,
    'editor.findMatchHighlightBackground': a(fill, 0.16),
    'editor.findMatchHighlightBorder': a(accent, 0.35),
    'editor.findRangeHighlightBackground': a(ink.fg, 0.05),
    'editor.rangeHighlightBackground': a(ink.fg, 0.05),
    'editor.symbolHighlightBackground': a(fill, 0.16),
    'editor.hoverHighlightBackground': a(h.time, 0.12),
    'editor.linkedEditingBackground': a(h.verification, 0.12),
    'editorLink.activeForeground': h.time,
    'editorWhitespace.foreground': a(ink.faint, 0.6),
    'editorIndentGuide.background1': s.border,
    'editorIndentGuide.activeBackground1': s.borderStrong,
    'editorRuler.foreground': s.border,
    'editorCodeLens.foreground': ink.subtle,
    'editorInlayHint.foreground': ink.subtle,
    'editorInlayHint.background': a(ink.fg, 0.05),
    'editorInlayHint.typeForeground': a(h.type, 0.75),
    'editorInlayHint.parameterForeground': ink.subtle,
    'editorLightBulb.foreground': h.warning,
    'editorLightBulbAutoFix.foreground': h.function,
    'editorBracketMatch.background': a(fill, 0.16),
    'editorBracketMatch.border': a(accent, 0.7),
    // One color at every nesting depth: a color says what a thing is, never how deep it sits. These are
    // what VS Code paints () [] {} with, in every language, and bracket pair guides fall back to them.
    'editorBracketHighlight.foreground1': ink.punctuation,
    'editorBracketHighlight.foreground2': ink.punctuation,
    'editorBracketHighlight.foreground3': ink.punctuation,
    'editorBracketHighlight.foreground4': ink.punctuation,
    'editorBracketHighlight.foreground5': ink.punctuation,
    'editorBracketHighlight.foreground6': ink.punctuation,
    'editorBracketHighlight.unexpectedBracket.foreground': h.error,
    'editorUnicodeHighlight.border': h.warning,
    'editorOverviewRuler.border': s.border,
    'editorOverviewRuler.findMatchForeground': a(accent, 0.8),
    'editorOverviewRuler.selectionHighlightForeground': a(s.selection, 0.9),
    'editorOverviewRuler.errorForeground': h.error,
    'editorOverviewRuler.warningForeground': h.warning,
    'editorOverviewRuler.infoForeground': h.time,
    'editorOverviewRuler.modifiedForeground': a(h.time, 0.8),
    'editorOverviewRuler.addedForeground': a(h.function, 0.8),
    'editorOverviewRuler.deletedForeground': a(h.error, 0.8),
    'editorOverviewRuler.bracketMatchForeground': a(accent, 0.8),

    // ---- diagnostics: the same red/yellow as `uvm_error / `uvm_warning IDs
    'editorError.foreground': h.error,
    'editorWarning.foreground': h.warning,
    'editorInfo.foreground': h.time,
    'editorHint.foreground': a(h.function, 0.7),
    'problemsErrorIcon.foreground': h.error,
    'problemsWarningIcon.foreground': h.warning,
    'problemsInfoIcon.foreground': h.time,
    'editorMarkerNavigation.background': s.widget,
    'editorMarkerNavigationError.background': h.error,
    'editorMarkerNavigationWarning.background': h.warning,
    'editorMarkerNavigationInfo.background': h.time,

    // ---- gutter and git
    'editorGutter.background': s.editor,
    'editorGutter.addedBackground': h.function,
    'editorGutter.modifiedBackground': h.time,
    'editorGutter.deletedBackground': h.error,
    'editorGutter.foldingControlForeground': ink.subtle,
    'gitDecoration.addedResourceForeground': ink.fg,
    'gitDecoration.modifiedResourceForeground': ink.fg,
    'gitDecoration.deletedResourceForeground': ink.fg,
    'gitDecoration.renamedResourceForeground': ink.fg,
    'gitDecoration.untrackedResourceForeground': ink.fg,
    'gitDecoration.ignoredResourceForeground': ink.fg,
    'gitDecoration.conflictingResourceForeground': ink.fg,
    'gitDecoration.submoduleResourceForeground': ink.fg,
    'gitDecoration.stageModifiedResourceForeground': ink.fg,
    'gitDecoration.stageDeletedResourceForeground': ink.fg,

    // ---- diff (RTL code reviews)
    'diffEditor.insertedTextBackground': a(h.function, 0.16),
    'diffEditor.removedTextBackground': a(h.error, 0.18),
    'diffEditor.insertedLineBackground': a(h.function, 0.08),
    'diffEditor.removedLineBackground': a(h.error, 0.08),
    'diffEditor.diagonalFill': s.border,
    'diffEditor.border': s.border,
    'diffEditorGutter.insertedLineBackground': a(h.function, 0.18),
    'diffEditorGutter.removedLineBackground': a(h.error, 0.18),
    'merge.currentHeaderBackground': a(h.function, 0.35),
    'merge.currentContentBackground': a(h.function, 0.12),
    'merge.incomingHeaderBackground': a(h.time, 0.35),
    'merge.incomingContentBackground': a(h.time, 0.12),
    'merge.commonHeaderBackground': a(ink.fg, 0.2),
    'merge.commonContentBackground': a(ink.fg, 0.08),

    // ---- widgets
    'editorWidget.background': s.widget,
    'editorWidget.foreground': ink.fg,
    'editorWidget.border': s.borderStrong,
    'editorWidget.resizeBorder': a(accent, 0.6),
    'editorHoverWidget.background': s.widget,
    'editorHoverWidget.foreground': ink.fg,
    'editorHoverWidget.border': s.borderStrong,
    'editorHoverWidget.statusBarBackground': s.sidebar,
    'editorSuggestWidget.background': s.widget,
    'editorSuggestWidget.foreground': ink.fg,
    'editorSuggestWidget.border': s.borderStrong,
    'editorSuggestWidget.selectedBackground': a(fill, 0.18),
    'editorSuggestWidget.selectedForeground': ink.bright,
    'editorSuggestWidget.highlightForeground': accent,
    'editorSuggestWidget.focusHighlightForeground': stronger(accent, 0.2),
    'editorStickyScroll.background': s.editor,
    'editorStickyScrollHover.background': s.hover,
    'editorStickyScroll.border': s.border,
    'editorStickyScroll.shadow': light ? '#00000026' : '#00000099',
    'editorStickyScrollGutter.background': s.editor,
    'peekView.border': accent,
    'peekViewEditor.background': mix(s.editor, s.widget, 0.5),
    'peekViewEditor.matchHighlightBackground': a(fill, 0.25),
    'peekViewResult.background': s.sidebar,
    'peekViewResult.fileForeground': ink.fg,
    'peekViewResult.lineForeground': ink.muted,
    'peekViewResult.matchHighlightBackground': a(fill, 0.25),
    'peekViewResult.selectionBackground': a(fill, 0.18),
    'peekViewResult.selectionForeground': ink.bright,
    'peekViewTitle.background': s.widget,
    'peekViewTitleLabel.foreground': ink.bright,
    'peekViewTitleDescription.foreground': ink.muted,
    'debugExceptionWidget.background': s.widget,
    'debugExceptionWidget.border': h.error,

    // ---- minimap and scrollbars
    'minimap.background': s.editor,
    'minimap.findMatchHighlight': a(accent, 0.7),
    'minimap.selectionHighlight': a(s.selection, 0.9),
    'minimap.errorHighlight': a(h.error, 0.85),
    'minimap.warningHighlight': a(h.warning, 0.85),
    'minimapGutter.addedBackground': h.function,
    'minimapGutter.modifiedBackground': h.time,
    'minimapGutter.deletedBackground': h.error,
    'minimapSlider.background': a(ink.fg, 0.08),
    'minimapSlider.hoverBackground': a(ink.fg, 0.12),
    'minimapSlider.activeBackground': a(ink.fg, 0.16),
    'scrollbar.shadow': light ? '#0000001F' : '#00000066',
    'scrollbarSlider.background': a(ink.fg, light ? 0.16 : 0.1),
    'scrollbarSlider.hoverBackground': a(ink.fg, light ? 0.26 : 0.18),
    'scrollbarSlider.activeBackground': a(accent, 0.45),

    // ---- panels, terminal (ANSI follows the roles: red = uvm_error, yellow = warning, ...)
    'panel.background': s.panel,
    'panel.border': s.border,
    'panelTitle.activeForeground': ink.bright,
    'panelTitle.activeBorder': accent,
    'panelTitle.inactiveForeground': ink.subtle,
    'panelSection.border': s.border,
    'panelSectionHeader.background': s.panel,
    'panelInput.border': s.borderStrong,
    'outputView.background': s.panel,
    'terminal.background': s.panel,
    'terminal.foreground': ink.fg,
    'terminal.border': s.border,
    'terminalCursor.foreground': accent,
    'terminal.selectionBackground': a(s.selection, 0.9),
    'terminal.findMatchBackground': a(fill, 0.4),
    'terminal.findMatchHighlightBackground': a(fill, 0.18),
    // On paper "white" still has to be readable (tools print it expecting a dark terminal), and the
    // bright colors go deeper rather than paler.
    'terminal.ansiBlack': hc ? '#3A3A3A' : light ? ink.fg : '#2A2D31',
    'terminal.ansiRed': h.error,
    'terminal.ansiGreen': h.function,
    'terminal.ansiYellow': h.warning,
    'terminal.ansiBlue': h.time,
    'terminal.ansiMagenta': magenta,
    'terminal.ansiCyan': h.type,
    'terminal.ansiWhite': light ? ink.subtle : ink.fg,
    'terminal.ansiBrightBlack': light ? ink.muted : ink.subtle,
    'terminal.ansiBrightRed': stronger(h.error, light ? 0.15 : 0.25),
    'terminal.ansiBrightGreen': stronger(h.function, light ? 0.15 : 0.3),
    'terminal.ansiBrightYellow': stronger(h.warning, light ? 0.15 : 0.3),
    'terminal.ansiBrightBlue': stronger(h.time, light ? 0.15 : 0.3),
    'terminal.ansiBrightMagenta': stronger(magenta, light ? 0.15 : 0.3),
    'terminal.ansiBrightCyan': stronger(h.type, light ? 0.15 : 0.3),
    'terminal.ansiBrightWhite': light ? ink.faint : '#FFFFFF',
    'terminalCommandDecoration.successBackground': h.function,
    'terminalCommandDecoration.errorBackground': h.error,
    'terminalCommandDecoration.defaultBackground': ink.subtle,
    'terminalOverviewRuler.cursorForeground': a(accent, 0.6),

    // ---- status bar: dark; remote (the farm) is accent orange, debugging is time blue
    'statusBar.background': s.chrome,
    'statusBar.foreground': ink.muted,
    'statusBar.border': s.border,
    'statusBar.focusBorder': a(accent, 0.6),
    'statusBar.noFolderBackground': s.chrome,
    'statusBar.noFolderForeground': ink.muted,
    'statusBar.debuggingBackground': h.time,
    'statusBar.debuggingForeground': roleInk,
    'statusBar.debuggingBorder': h.time,
    'statusBarItem.remoteBackground': fill,
    'statusBarItem.remoteForeground': accentInk,
    'statusBarItem.remoteHoverBackground': mix(fill, '#FFFFFF', 0.15),
    'statusBarItem.remoteHoverForeground': accentInk,
    'statusBarItem.hoverBackground': s.hover,
    'statusBarItem.hoverForeground': ink.bright,
    'statusBarItem.activeBackground': s.active,
    'statusBarItem.prominentBackground': a(fill, 0.25),
    'statusBarItem.prominentForeground': ink.bright,
    'statusBarItem.prominentHoverBackground': a(fill, 0.35),
    'statusBarItem.errorBackground': errorBg,
    'statusBarItem.errorForeground': '#FFFFFF',
    'statusBarItem.warningBackground': warningBg,
    'statusBarItem.warningForeground': roleInk,
    'statusBarItem.compactHoverBackground': s.hover,
    'statusBarItem.focusBorder': a(accent, 0.6),

    // ---- inputs and controls
    'input.background': s.input,
    'input.foreground': ink.fg,
    'input.border': s.borderStrong,
    'input.placeholderForeground': ink.subtle,
    'inputOption.activeBackground': a(fill, 0.25),
    'inputOption.activeBorder': a(accent, 0.7),
    'inputOption.activeForeground': ink.bright,
    'inputValidation.errorBackground': mix(h.error, s.input, 0.8),
    'inputValidation.errorBorder': h.error,
    'inputValidation.warningBackground': mix(h.warning, s.input, 0.85),
    'inputValidation.warningBorder': h.warning,
    'inputValidation.infoBackground': mix(h.time, s.input, 0.85),
    'inputValidation.infoBorder': h.time,
    'dropdown.background': s.input,
    'dropdown.foreground': ink.fg,
    'dropdown.border': s.borderStrong,
    'dropdown.listBackground': s.widget,
    'checkbox.background': s.input,
    'checkbox.border': s.borderStrong,
    'checkbox.foreground': ink.fg,
    'checkbox.selectBackground': s.widget,
    'button.background': fill,
    'button.foreground': accentInk,
    'button.hoverBackground': mix(fill, '#FFFFFF', 0.15),
    'button.secondaryBackground': s.active,
    'button.secondaryForeground': ink.fg,
    'button.secondaryHoverBackground': s.borderStrong,
    'button.border': a(accent, 0),
    'button.separator': a(accentInk, 0.4),
    'badge.background': a(fill, 0.25),
    'badge.foreground': ink.bright,
    'keybindingLabel.background': a(ink.fg, 0.08),
    'keybindingLabel.foreground': ink.fg,
    'keybindingLabel.border': s.borderStrong,
    'keybindingLabel.bottomBorder': s.border,
    'quickInput.background': s.widget,
    'quickInput.foreground': ink.fg,
    'quickInputTitle.background': s.sidebar,
    'quickInputList.focusBackground': a(fill, 0.2),
    'quickInputList.focusForeground': ink.bright,
    'pickerGroup.border': s.border,
    'pickerGroup.foreground': accent,
    'notifications.background': s.widget,
    'notifications.foreground': ink.fg,
    'notifications.border': s.borderStrong,
    'notificationCenterHeader.background': s.sidebar,
    'notificationCenterHeader.foreground': ink.fg,
    'notificationsErrorIcon.foreground': h.error,
    'notificationsWarningIcon.foreground': h.warning,
    'notificationsInfoIcon.foreground': h.time,
    'notificationLink.foreground': h.time,
    'notificationToast.border': s.borderStrong,

    // ---- settings, welcome, walkthroughs
    'settings.headerForeground': ink.bright,
    'settings.modifiedItemIndicator': accent,
    'settings.focusedRowBackground': a(ink.fg, 0.04),
    'settings.focusedRowBorder': a(accent, 0.4),
    'settings.rowHoverBackground': a(ink.fg, 0.03),
    'settings.headerBorder': s.border,
    'settings.sashBorder': s.border,
    'welcomePage.background': s.editor,
    'welcomePage.tileBackground': s.widget,
    'welcomePage.tileHoverBackground': s.hover,
    'welcomePage.tileBorder': s.border,
    'welcomePage.progress.background': s.active,
    'welcomePage.progress.foreground': accent,
    'walkThrough.embeddedEditorBackground': s.widget,
    'walkthrough.stepTitle.foreground': ink.bright,

    // ---- debugging and testing
    'debugToolBar.background': s.widget,
    'debugToolBar.border': s.borderStrong,
    'debugIcon.breakpointForeground': h.error,
    'debugIcon.breakpointDisabledForeground': ink.subtle,
    'debugIcon.breakpointUnverifiedForeground': ink.muted,
    'debugIcon.breakpointCurrentStackframeForeground': h.warning,
    'debugIcon.breakpointStackframeForeground': h.function,
    'debugIcon.startForeground': h.function,
    'debugIcon.pauseForeground': h.time,
    'debugIcon.stopForeground': h.error,
    'debugIcon.restartForeground': h.function,
    'debugIcon.stepOverForeground': h.time,
    'debugIcon.stepIntoForeground': h.time,
    'debugIcon.stepOutForeground': h.time,
    'debugIcon.continueForeground': h.time,
    'editor.stackFrameHighlightBackground': a(h.warning, 0.12),
    'editor.focusedStackFrameHighlightBackground': a(h.function, 0.12),
    'debugTokenExpression.name': h.type,
    'debugTokenExpression.value': ink.fg,
    'debugTokenExpression.string': h.string,
    'debugTokenExpression.number': h.number,
    'debugTokenExpression.boolean': h.number,
    'debugTokenExpression.error': h.error,
    'debugConsole.infoForeground': h.time,
    'debugConsole.warningForeground': h.warning,
    'debugConsole.errorForeground': h.error,
    'debugConsole.sourceForeground': ink.muted,
    'debugConsoleInputIcon.foreground': accent,
    'testing.iconPassed': h.function,
    'testing.iconFailed': h.error,
    'testing.iconErrored': h.error,
    'testing.iconQueued': h.warning,
    'testing.iconSkipped': ink.subtle,
