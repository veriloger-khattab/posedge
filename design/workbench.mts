    'symbolIcon.nullForeground': h.number,
    'symbolIcon.functionForeground': h.function,
    'symbolIcon.methodForeground': h.function,
    'symbolIcon.constructorForeground': h.function,
    'symbolIcon.eventForeground': h.time,
    'symbolIcon.unitForeground': h.time,
    'symbolIcon.moduleForeground': h.keyword,
    'symbolIcon.keywordForeground': h.keyword,
    'symbolIcon.namespaceForeground': h.type,
    'symbolIcon.packageForeground': h.type,
    'symbolIcon.snippetForeground': h.macro,
    'symbolIcon.stringForeground': h.string,
    'symbolIcon.variableForeground': ink.fg,
    'symbolIcon.fieldForeground': ink.fg,
    'symbolIcon.propertyForeground': ink.fg,
    'symbolIcon.arrayForeground': ink.fg,
    'symbolIcon.objectForeground': ink.fg,
    'symbolIcon.keyForeground': h.type,
    'symbolIcon.operatorForeground': ink.operator,
    'symbolIcon.referenceForeground': ink.muted,
    'symbolIcon.fileForeground': ink.muted,
    'symbolIcon.folderForeground': ink.muted,
    'symbolIcon.colorForeground': h.verification,
    'symbolIcon.textForeground': ink.fg,

    // ---- charts and misc
    'charts.foreground': ink.fg,
    'charts.lines': s.borderStrong,
    'charts.red': h.error,
    'charts.blue': h.time,
    'charts.yellow': h.warning,
    'charts.orange': h.macro,
    'charts.green': h.function,
    'charts.purple': h.number,
    'editorGhostText.foreground': a(ink.fg, 0.35),
    'editorOverviewRuler.wordHighlightForeground': a(h.time, 0.6),
    'editorOverviewRuler.wordHighlightStrongForeground': a(h.keyword, 0.6),

    // ---- Posedge's own colors (clock)
    'posedge.clockForeground': accent,
    'posedge.dateForeground': ink.muted,
  };

  if (hc) {
    Object.assign(colors, {
      contrastBorder: '#6E7378',
      contrastActiveBorder: accent,
      'editor.selectionForeground': '#FFFFFF',
      'list.activeSelectionBackground': '#000000',
      'list.inactiveSelectionBackground': '#000000',
      'list.hoverBackground': '#000000',
      'tab.activeBackground': '#000000',
      'tab.inactiveBackground': '#000000',
      'statusBar.background': '#000000',
      'statusBarItem.remoteForeground': '#000000',
      'statusBar.debuggingForeground': '#000000',
      'button.foreground': '#000000',
      'activityBarBadge.foreground': '#000000',
    });
  }
  return colors;
}

