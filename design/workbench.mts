    // ---- symbols in Outline / suggest follow the token roles
    'symbolIcon.classForeground': h.type,
    'symbolIcon.structForeground': h.type,
    'symbolIcon.interfaceForeground': h.type,
    'symbolIcon.enumeratorForeground': h.type,
    'symbolIcon.typeParameterForeground': h.type,
    'symbolIcon.enumeratorMemberForeground': h.number,
    'symbolIcon.constantForeground': h.number,
    'symbolIcon.numberForeground': h.number,
