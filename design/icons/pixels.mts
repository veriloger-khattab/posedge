/** Converts a bitmap to an SVG path (horizontal runs merged), top-left at (x, y). */
export function bitmapPath(rows: string[], x: number, y: number): string {
  let d = '';
  rows.forEach((row, r) => {
    let c = 0;
    while (c < row.length) {
      if (row[c] !== '#') {
        c++;
        continue;
      }
      let w = 1;
      while (row[c + w] === '#') w++;
      d += `M${x + c} ${y + r}h${w}v1h-${w}z`;
      c += w;
    }
  });
  return d;
}

/** Width in pixels of a label in the micro-font (1 px between characters). */
export function labelWidth(text: string): number {
  return text.length * 4 - 1;
}

/** SVG path for a label in the micro-font, top-left at (x, y). */
export function labelPath(text: string, x: number, y: number): string {
  let d = '';
  [...text.toUpperCase()].forEach((ch, i) => {
    const glyph = FONT[ch];
    if (!glyph) throw new Error(`No micro-font glyph for "${ch}"`);
    d += bitmapPath(glyph, x + i * 4, y);
  });
  return d;
}
